# Copy to .env (git-ignored) and fill in. Loaded by spring.config.import in
# application.properties. In production the same names come from the real
# environment (/etc/sirnik-blog.env), not from a file in the repo.
#
# Spring reads this file as .properties: no quotes around values, and keep
# comments on their own line (text after a value becomes part of the value).

# --- Database (prod profile only) -------------------------------------------
# Local development uses the in-memory H2 database and ignores these. The prod
# profile (SPRING_PROFILES_ACTIVE=prod) requires all three at startup, see
# application-prod.properties. The other production-only settings
# (SPRING_PROFILES_ACTIVE, SERVER_*) live in /etc/sirnik-blog.env, see README.
BLOG_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/blog
BLOG_DATABASE_USERNAME=blog
BLOG_DATABASE_PASSWORD=

# --- Registration -------------------------------------------------------------
# Master switch for creating NEW accounts. false closes the register page and
# must also make the POST handler refuse requests. Requests that are already
# pending can still be approved. Use exactly true or false.
BLOG_REGISTRATION_ENABLED=false

# --- Mail over SMTP (approval and confirmation emails) -----------------------
# Production example is Resend with STARTTLS on port 587. The API key is the
# SMTP password; any provider that offers SMTP works the same way. Port 465 is
# implicit TLS rather than STARTTLS and needs different spring.mail.properties
# settings than 587, so change the port and those settings together.
# Local development: run an SMTP sink such as Mailpit and use
#   BLOG_MAIL_HOST=localhost, BLOG_MAIL_PORT=1025, empty username and API key.
BLOG_MAIL_HOST=smtp.resend.com
BLOG_MAIL_PORT=587
BLOG_MAIL_USERNAME=resend
BLOG_MAIL_API_KEY=

# Sender address. Must be on a domain verified with the mail provider
# (SPF/DKIM records), for example blog@sirnik.dev.
BLOG_MAIL_FROM=

# Where "approve this registration" emails are sent: the site owner's inbox.
BLOG_APPROVER_EMAIL=

# Public origin used to build absolute links inside emails. Set explicitly
# rather than deriving from the request, which can be wrong behind a proxy.
# Production: https://sirnik.dev
BLOG_BASE_URL=http://localhost:8080

# --- Link tokens (JWT) ----------------------------------------------------------
# Secret that signs (HS256) and verifies the tokens in emailed approval and
# confirmation links. It needs at least 32 bytes of randomness. Generate one with:
#   openssl rand -hex 32
# Keep it stable: changing it invalidates every link already sent. Use a
# different value in each environment and never commit it.
BLOG_JWT_SECRET=
