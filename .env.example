# Copy to .env (git-ignored) and fill in. Loaded by spring.config.import in
# application.properties. In production the same names come from the real
# environment (/etc/sirnik-blog.env), not from a file in the repo.

# The single fixed admin login. There is no registration.
BLOG_ADMIN_USERNAME=admin

# BCrypt hash of the admin password, NOT the plain password.
# Generate one (cost 12) with:
#   htpasswd -bnBC 12 "" 'your-long-random-password' | tr -d ':\n' | pbcopy
# (pbcopy is macOS; without it, zsh prints a highlighted % after the hash when
# there is no trailing newline. Do not copy that % into the value.)
BLOG_ADMIN_PASSWORD_HASH=
